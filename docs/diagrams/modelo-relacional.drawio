        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml modelo-relacional\ntitle Modelo Relacional - SetlistGen\nhide circle\nskinparam linetype ortho\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\n\nentity \&quot;dj\&quot; as dj {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  * usuario : TEXT &lt;&lt;UK&gt;&gt;\n  * password_hash : TEXT\n  * fecha_creacion : TEXT\n}\n\nentity \&quot;biblioteca\&quot; as biblioteca {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  * dj_id : INTEGER &lt;&lt;FK&gt;&gt;\n  * nombre : TEXT\n  * ruta_raiz : TEXT\n  * fecha_creacion : TEXT\n  * fecha_ultima_actualizacion : TEXT\n  --\n  UK (dj_id, ruta_raiz)\n}\n\nentity \&quot;pista\&quot; as pista {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  * dj_id : INTEGER &lt;&lt;FK&gt;&gt;\n  * ruta_local : TEXT\n  titulo : TEXT\n  artista : TEXT\n  duracion_seg : REAL\n  genero : TEXT\n  bpm : REAL\n  tonalidad : TEXT\n  codigo_camelot : TEXT &lt;&lt;generada&gt;&gt;\n  * tamano_bytes : INTEGER\n  * fecha_modificacion_archivo : INTEGER\n  * estado : TEXT\n  motivo_fallo : TEXT\n  motor_mir : TEXT\n  fecha_analisis : TEXT\n  --\n  UK (dj_id, ruta_local)\n}\n\nentity \&quot;biblioteca_pista\&quot; as biblioteca_pista {\n  * biblioteca_id : INTEGER &lt;&lt;PK, FK&gt;&gt;\n  * pista_id : INTEGER &lt;&lt;PK, FK&gt;&gt;\n}\n\nentity \&quot;setlist\&quot; as setlist {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  * dj_id : INTEGER &lt;&lt;FK&gt;&gt;\n  * nombre : TEXT\n  * fecha_creacion : TEXT\n  * fecha_modificacion : TEXT\n  * duracion_objetivo_seg : REAL\n  * tolerancia_pct : REAL\n  * bpm_min : REAL\n  * bpm_max : REAL\n  * preset_camelot : TEXT\n  * semilla : INTEGER\n  --\n  UK (dj_id, nombre)\n}\n\nentity \&quot;setlist_pista\&quot; as setlist_pista {\n  * setlist_id : INTEGER &lt;&lt;PK, FK&gt;&gt;\n  * pista_id : INTEGER &lt;&lt;PK, FK&gt;&gt;\n  --\n  * orden : INTEGER\n  --\n  UK (setlist_id, orden)\n}\n\ndj ||--o{ biblioteca : \&quot;tiene\&quot;\ndj ||--o{ pista : \&quot;posee\&quot;\ndj ||--o{ setlist : \&quot;es propietario\&quot;\n\nbiblioteca ||--o{ biblioteca_pista : \&quot;contiene\&quot;\npista ||--o{ biblioteca_pista : \&quot;está en\&quot;\n\nsetlist ||--|{ setlist_pista : \&quot;incluye\&quot;\npista ||--o{ setlist_pista : \&quot;aparece en\&quot;\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="n8S3RdC69B7lar7pV72A-1">
