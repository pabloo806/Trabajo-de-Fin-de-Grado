@startchen
title Modelo Entidad-Relación - SetlistGen
left to right direction

entity DJ {
  id : INTEGER <<key>>
  usuario : TEXT
  password_hash : TEXT
  fecha_creacion : DATE
}

entity BIBLIOTECA {
  id : INTEGER <<key>>
  nombre : TEXT
  ruta_raiz : TEXT
  fecha_creacion : DATE
  fecha_ultima_actualizacion : DATE
}

entity PISTA {
  id : INTEGER <<key>>
  ruta_local : TEXT
  titulo : TEXT
  artista : TEXT
  duracion_seg : REAL
  genero : TEXT
  bpm : REAL
  tonalidad : TEXT
  codigo_camelot : TEXT <<derived>>
  tamano_bytes : INTEGER
  fecha_modificacion_archivo : INTEGER
  estado : TEXT
  motivo_fallo : TEXT
}

entity SETLIST {
  id : INTEGER <<key>>
  nombre : TEXT
  fecha_creacion : DATE
  fecha_modificacion : DATE
  duracion_objetivo_seg : REAL
  tolerancia_pct : REAL
  bpm_min : REAL
  bpm_max : REAL
  preset_camelot : TEXT
  semilla : INTEGER
}

relationship TIENE_BIBLIOTECA {
}

relationship CONTIENE {
}

relationship PERTENECE_A_SETLIST {
  orden : INTEGER
}

relationship PERTENECE_A_DJ {
}

DJ -1- TIENE_BIBLIOTECA
TIENE_BIBLIOTECA -N- BIBLIOTECA

BIBLIOTECA -N- CONTIENE
CONTIENE -M- PISTA

PISTA -N- PERTENECE_A_SETLIST
PERTENECE_A_SETLIST -M- SETLIST

SETLIST -N- PERTENECE_A_DJ
PERTENECE_A_DJ -1- DJ
@endchen